# Easy to Excel Clear - Backend Configuration

# Server
NODE_ENV=development
PORT=5000

# Claude API Configuration
# Get your API key from: https://console.anthropic.com
CLAUDE_API_KEY=sk-ant-your-api-key-here

# AI Model (current supported models as of Sept 2025)
# Options: 
#   - claude-sonnet-5-20250929 (recommended, best balance)
#   - claude-haiku-4-5-20251001 (fastest, cheapest)
#   - claude-opus-5-20250514 (most capable)
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-20250929
